client-hello = [
  client-nonce: bytes .size 32,
  minimum-major: uint,
  maximum-major: uint,
  minimum-minor: uint,
  maximum-minor: uint,
  claimed-role: 1..3,
  component-build-id: bytes .size 32,
  required-features: [*16 uint]
]

server-hello = [
  server-nonce: bytes .size 32,
  selected-major: uint,
  selected-minor: uint,
  derived-role: 1..3,
  granted-features: [*16 uint],
  maximum-payload-bytes: uint,
  maximum-in-flight: uint,
  agent-state: 1..7,
  unlock-epoch: uint
]

endpoint-descriptor = [
  schema: 1,
  pipe-name: text .size (1..512),
  agent-process-id: uint,
  agent-process-creation-time: uint,
  package-full-name: text .size (1..256),
  minimum-major: uint,
  maximum-major: uint,
  startup-nonce: bytes .size 32
]

request = [
  operation: uint,
  unlock-epoch: uint,
  relative-timeout-ms: 1..4294967295,
  idempotency-key: bytes .size 16 / null,
  operation-body: bytes .size (0..65408)
]

response = [
  error-code: uint,
  retry-category: uint,
  correlation-id: bytes .size 16,
  result-body: bytes .size (0..65440)
]

event = [
  agent-state: 1..7,
  unlock-epoch: uint
]

status-body = []
create-vault-body = [master-password: text .size (0..1024)]
unlock-master-password-body = [master-password: text .size (0..1024)]
lock-body = []
list-account-summaries-body = [
  offset: uint,
  limit: 1..100
]
get-account-body = [record-id: bytes .size 16]
add-account-body = [account-fields]
update-account-body = [record-id: bytes .size 16, account-fields]
delete-account-body = [record-id: bytes .size 16]
enroll-windows-hello-body = [parent-window: 1..18446744073709551615]
unlock-windows-hello-body = [parent-window: 1..18446744073709551615]
remove-windows-hello-body = []
make-passkey-body = [passkey-transaction-proof]
get-passkey-assertion-body = [
  passkey-transaction-proof,
  credential-id: bytes .size 32
]
delete-passkey-body = [credential-id: bytes .size 32]
list-passkeys-for-assertion-body = [passkey-request-proof]
list-passkeys-body = []

passkey-request-proof = (
  transaction-id: bytes .size 16,
  request-type: 1,
  windows-request-signature: bytes .size (1..2048),
  encoded-ctap2-request: bytes .size (1..49152)
)

passkey-transaction-proof = (
  passkey-request-proof,
  agent-connection-challenge: bytes .size 16,
  windows-uv-signature: bytes .size (1..2048)
)

account-fields = (
  service-name: text .size (0..256),
  permitted-origin: text .size (0..2048),
  username: text .size (0..1024),
  password: text .size (0..16384)
)

status-result = [agent-state: 1..7, unlock-epoch: uint]
empty-result = []
account-id-result = [record-id: bytes .size 16]
passkey-credential-result = [
  credential-id: bytes .size 32,
  user-handle: bytes .size (1..64),
  uncompressed-p256-public-key: bytes .size 65
]
passkey-assertion-result = [
  credential-id: bytes .size 32,
  user-handle: bytes .size (1..64),
  authenticator-data: bytes .size 37,
  es256-signature-der: bytes .size (1..80)
]
passkey-summaries-result = [*64 passkey-summary]
passkey-summary = [
  credential-id: bytes .size 32,
  user-handle: bytes .size (1..64),
  user-name: text .size (1..256),
  user-display-name: text .size (1..256)
]
passkey-management-summaries-result = [*64 passkey-management-summary]
passkey-management-summary = [
  credential-id: bytes .size 32,
  rp-id: text .size (1..253),
  user-name: text .size (1..256),
  user-display-name: text .size (1..256)
]
account-result = [
  record-id: bytes .size 16,
  revision: uint,
  created-at-ms: uint,
  modified-at-ms: uint,
  service-name: text .size (0..256),
  permitted-origin: text .size (0..2048),
  username: text .size (0..1024),
  password: text .size (0..16384)
]
account-summaries-result = [
  next-offset: uint / null,
  summaries: [*100 account-summary]
]
account-summary = [
  record-id: bytes .size 16,
  revision: uint,
  created-at-ms: uint,
  modified-at-ms: uint,
  service-name: text .size (0..256),
  permitted-origin: text .size (0..2048),
  username: text .size (0..1024)
]
