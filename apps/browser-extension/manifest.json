{
  "manifest_version": 3,
  "name": "Librarian",
  "description": "Connects Chrome and Edge to the Librarian desktop app.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "105",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Check Librarian connection"
  },
  "permissions": [
    "nativeMessaging"
  ]
}
