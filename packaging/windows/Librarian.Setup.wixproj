<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <EnableDefaultItems>false</EnableDefaultItems>
    <OutputName>LibrarianSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)\Librarian.Setup.packages.lock.json</NuGetLockFilePath>
    <DefineConstants>
      $(DefineConstants);
      ProductVersion=$(ProductVersion);
      MsiPath=$(MsiPath);
      LogoPath=$(LogoPath);
      SplashScreenPath=$(SplashScreenPath)
    </DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
